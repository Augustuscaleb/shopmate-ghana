# Copy to .env (which is git-ignored) and fill in for your environment.
# These two values are PUBLIC by design (they ship inside the app). Data is
# protected by Row Level Security, not by keeping these secret.
#
# NEVER put the service-role key or the database password here or anywhere in the app.
#
# Local development (values printed by `npm run db:start` at the repository root):
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key
